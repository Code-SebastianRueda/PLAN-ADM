# ============================================================
# PLAN-ADM — variables de entorno (plantilla)
# ============================================================
# Copia este archivo a .env y ajusta los valores. NO subas .env al repo.
#   cp .env.example .env

# ---- Base de datos (PostgreSQL del docker-compose) ----
POSTGRES_USER=planadm
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=planadm
# El propio compose arma DATABASE_URL a partir de las anteriores.
# Si usas una DB externa (p. ej. RDS), define DATABASE_URL directamente:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/planadm

# ---- Usuario admin inicial de la app (seed en el primer arranque) ----
PLANADM_USER=admin
PLANADM_PASSWORD=cambia-esta-clave-admin

# ---- Secretos de nubes ----
# SECRETS_BACKEND=env  -> lee de estas variables / .env (desarrollo)
# SECRETS_BACKEND=aws  -> lee de AWS Secrets Manager (producción en EC2 con IAM role)
SECRETS_BACKEND=env
SECRETS_NAME=planadm/secrets
AWS_REGION=us-east-1

# ---- Azure Service Principal (opcional, modo desatendido) ----
# Si se definen, se podrá autenticar sin device-code interactivo.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- AWS (opcional, integración futura) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Refresco diario desatendido (servicio 'scheduler') ----
# Hora UTC del refresco. 11:00 UTC = 06:00 America/Bogota (Colombia).
ORBIT_REFRESH_UTC_HOUR=11
ORBIT_REFRESH_UTC_MINUTE=0
# Clientes a precargar cada mañana. JSON con una lista de Service Principals.
# DÉJALO VACÍO hasta tener los accesos: el job corre pero no hace nada.
# Ejemplo (una sola línea):
# ORBIT_DAILY_CLIENTS=[{"name":"Cliente A","tenant_id":"...","client_id":"...","client_secret":"..."}]
ORBIT_DAILY_CLIENTS=
